#!/usr/bin/env python3
"""Exercise the real QML panel and render screenshots with Quickshell offscreen."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--output", type=Path, default=root / ".cache/previews")
args = parser.parse_args()
args.output.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix="lockin-preview-") as directory:
    path = Path(directory)
    for module in ("Commons", "Ui"):
        (path / module).symlink_to(Path("/usr/share/omarchy/shell") / module)
    qml = (root / "tests/PreviewShell.qml").read_text()
    qml = qml.replace('"@ROOT@"', json.dumps(root.as_uri())).replace('"@OUTPUT@"', json.dumps(str(args.output.resolve())))
    (path / "shell.qml").write_text(qml)
    for language in ("en", "pt"):
        (path / "language").write_text(language)
        result = subprocess.run(["quickshell", "--no-color", "-p", str(path / "shell.qml")],
                                env={**os.environ, "QT_QPA_PLATFORM": "offscreen", "QT_QUICK_BACKEND": "software",
                                     "QT_FORCE_STDERR_LOGGING": "1", "OMARCHY_LANGUAGE_FILE": str(path / "language"),
                                     "LOCKIN_PREVIEW_LANGUAGE": language}, timeout=40,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        print(result.stdout)
        if result.returncode or "FAIL!" in result.stdout or "Panel checks passed" not in result.stdout:
            raise SystemExit(1)
    print(f"Panel interactions passed. Screenshots: {args.output}")
